{
  "name": "schwindelex",
  "version": "0.1.0",
  "private": true,
  "description": "Browser-Multiplayer-Ratespiel im Stil von Nobody's Perfect",
  "license": "Unlicense",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node server/src/main.ts",
    "dev:server": "node --watch server/src/main.ts",
    "dev:client": "vite --config client/vite.config.ts",
    "build": "vite build --config client/vite.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit && tsc --noEmit -p client",
    "eval:judge": "node server/src/ai/eval/runJudgeEval.ts",
    "loadtest": "node --expose-gc server/src/loadtest.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^24.19.1",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "preact": "^11.0.0",
    "qrcode": "^1.5.4",
    "ws": "^8.22.0"
  }
}
