# Kopieren nach .env und ausfüllen. .env wird nie committet.

# Anthropic API-Key für Claude Haiku (Gruppieren + Prüfen der Antworten)
ANTHROPIC_API_KEY=

# PIN, die zum Erstellen einer Lobby nötig ist
HOST_PIN=

# HTTP-Port des Node-Servers (lokal und hinter nginx)
PORT=3000

# Öffentliche Basis-URL für Einladungslinks und QR-Codes
PUBLIC_URL=http://localhost:3000

# Wortliste: data/words.test.json für Entwicklung, data/words.json für echtes Spiel
WORDS_FILE=data/words.test.json
